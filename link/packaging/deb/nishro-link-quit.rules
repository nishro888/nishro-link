// Nishro Link's Quit and Open (service.py, control()): the person at the
// desktop may stop and start this one service without a password - if they
// are in the `input` group, which can read every keyboard here already.
// polkit 0.106 and later read this; older ones ask for the password instead.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
            action.lookup("unit") === "nishro-link.service" &&
            (action.lookup("verb") === "start" || action.lookup("verb") === "stop") &&
            subject.local && subject.active && subject.isInGroup("input")) {
        return polkit.Result.YES;
    }
});
