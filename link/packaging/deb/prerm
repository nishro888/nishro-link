#!/bin/sh
# Before removing or upgrading: stop the service, and drop the bytecode
# postinst compiled, which dpkg does not know about.
set -e

case "$1" in
remove|deconfigure)
    if [ -d /run/systemd/system ]; then
        systemctl stop nishro-link.service 2>/dev/null || true
        systemctl disable nishro-link.service 2>/dev/null || true
    fi
    # Open windows and tray icons too: their program is about to go.
    pkill -f "link[.]nishro_link|nishro-link/launch[.]py" 2>/dev/null || true
    rm -rf /usr/lib/nishro-link/link/__pycache__
    ;;
upgrade)
    # postinst of the new version restarts it.
    if [ -d /run/systemd/system ]; then
        systemctl stop nishro-link.service 2>/dev/null || true
    fi
    rm -rf /usr/lib/nishro-link/link/__pycache__
    ;;
esac

exit 0
