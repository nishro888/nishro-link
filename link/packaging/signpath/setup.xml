<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "setup": the setup wizard, as the release
     build hands it over (a zip holding that one file), built around the
     program signed a moment earlier. Only a file whose Properties name
     Nishro Link, at the version being released, is signed. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="NishroLink-Setup-${version}.exe" product-name="Nishro Link" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
