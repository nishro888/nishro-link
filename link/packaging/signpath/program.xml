<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "program": NishroLink.exe, as the release
     build hands it over (a zip holding that one file). Only a file whose
     Properties name Nishro Link, at the version being released, is signed. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="NishroLink.exe" product-name="Nishro Link" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
